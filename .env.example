# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & Cache (Supabase PostgreSQL / Connection Pooler)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=15
REDIS_URL=redis://redis:6379

# Razorpay Test Mode Credentials (System Default)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_YOUR_WEBHOOK_SECRET

# Razorpay Production / Live Credentials (Real Money)
RAZORPAY_LIVE_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_LIVE_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_LIVE_WEBHOOK_SECRET=rzp_whsec_YOUR_LIVE_WEBHOOK_SECRET

# Portfolio Capacity Limits
MAX_LINKS_PER_RUN=5

# Server Port
PORT=3001

# NVIDIA NIM LLM Integration (Decision Explainer Only - Zero LLM on Execution Path)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Set to 'true' to disable LLM-generated semantic signal influence on IVEN scoring (pure deterministic mode)
DISABLE_LLM_SCORING_INFLUENCE=true

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

APP_URL=https://ctrl-recovery.vercel.app

# Primary Transactional Email Provider (Gmail SMTP)
# For Gmail: generate a 16-character Google App Password at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="CTRL Recovery <your-email@gmail.com>"
